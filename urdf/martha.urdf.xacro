<?xml version="1.0"?>
<!-- Martha for martha_nav. Derived from martha/urdf/learning.xacro, keeping its
     geometry and dropping what this package does not use: namespaces and frame
     prefixes (one robot), the IMU, the mecanum wheels with their rollers and the
     ros2_control stack. The policy drives /cmd_vel through planar_move, so the
     wheels are decoration that also holds the chassis off the floor.

     Geometry must match martha_nav/sim2d/geometry.py: footprint 0.56 x 0.41 m and
     the LiDAR 0.2325 m ahead of base_link.

     xacro urdf/martha.urdf.xacro -o /tmp/martha.urdf
-->
<robot name="martha" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="lidar_samples" default="360" />
    <xacro:arg name="lidar_visualize" default="false" />

    <material name="black"><color rgba="0 0 0 1" /></material>
    <material name="grey"><color rgba="0.7 0.7 0.7 1" /></material>
    <material name="red"><color rgba="1 0 0 1" /></material>

    <!-- Chassis: a narrow front and rear plate around a wider centre plate. -->
    <xacro:property name="base_front_x" value="0.160" />
    <xacro:property name="base_center_x" value="0.238" />
    <xacro:property name="base_rear_x" value="0.160" />
    <xacro:property name="base_narrow_y" value="0.240" />
    <xacro:property name="base_center_y" value="0.410" />
    <xacro:property name="base_z" value="0.025" />
    <xacro:property name="height_0" value="0.125" />
    <xacro:property name="wheel_length" value="0.045" />
    <xacro:property name="wheel_radius" value="0.075" />
    <!-- Wheels sit inside the contact shell (0.20 + 0.075 = 0.275 < 0.28) so a wall
         always touches the shell first, and the bumper reports it. -->
    <xacro:property name="wheel_pos_x" value="0.20" />
    <xacro:property name="wheel_pos_y" value="0.175" />
    <xacro:property name="wheel_pos_z" value="0.08" />
    <xacro:property name="lidar_length" value="0.04" />
    <xacro:property name="lidar_radius" value="0.0475" />
    <!-- LIDAR_OFFSET_X in martha_nav/sim2d/geometry.py, and where it sits on the robot. -->
    <xacro:property name="lidar_x" value="0.2325" />
    <!-- Collision envelope used for contacts, 0.56 x 0.41 m, held above the floor
         so wheel support never counts as a collision. -->
    <xacro:property name="contact_shell_x" value="0.560" />
    <xacro:property name="contact_shell_y" value="0.410" />
    <xacro:property name="contact_shell_center_z" value="0.125" />
    <xacro:property name="contact_shell_height" value="0.200" />
    <xacro:property name="lidar_shell_clearance" value="0.010" />

    <link name="base_link">
        <visual>
            <origin xyz="${base_center_x/2 + base_front_x/2} 0 ${height_0}"/>
            <geometry><box size="${base_front_x} ${base_narrow_y} ${base_z}"/></geometry>
            <material name="grey"/>
        </visual>
        <visual>
            <origin xyz="0 0 ${height_0}"/>
            <geometry><box size="${base_center_x} ${base_center_y} ${base_z}"/></geometry>
            <material name="grey"/>
        </visual>
        <visual>
            <origin xyz="${-(base_center_x/2 + base_rear_x/2)} 0 ${height_0}"/>
            <geometry><box size="${base_rear_x} ${base_narrow_y} ${base_z}"/></geometry>
            <material name="grey"/>
        </visual>

        <!-- One collision only: the contact shell. It is the same rectangle the
             2D simulator checks, so a contact here means a collision there. -->
        <collision name="contact_shell_collision">
            <origin xyz="0 0 ${contact_shell_center_z}"/>
            <geometry>
                <box size="${contact_shell_x} ${contact_shell_y} ${contact_shell_height}"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="20"/>
            <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>

    <link name="lidar">
        <visual>
            <geometry><cylinder length="${lidar_length}" radius="${lidar_radius}"/></geometry>
            <material name="red" />
        </visual>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="1e-4" ixy="0.0" ixz="0.0" iyy="1e-4" iyz="0.0" izz="1e-4"/>
        </inertial>
    </link>

    <joint name="base_lidar" type="fixed">
        <parent link="base_link" />
        <child link="lidar" />
        <!-- x = 0.2325 m, the value LIDAR_OFFSET_X uses. The scan plane sits above
             the contact shell so the robot never sees itself. -->
        <origin xyz="${lidar_x} 0 ${contact_shell_center_z + contact_shell_height/2 + lidar_length/2 + lidar_shell_clearance}"/>
    </joint>

    <!-- Fixed wheels: they are not actuated, they only carry the chassis. -->
    <xacro:macro name="wheel" params="name x y">
        <link name="${name}_wheel">
            <visual>
                <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}" /></geometry>
                <material name="black" />
            </visual>
            <collision>
                <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}" /></geometry>
            </collision>
            <inertial>
                <mass value="0.5"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>
        <joint name="base_${name}_wheel_joint" type="fixed">
            <parent link="base_link" />
            <child link="${name}_wheel" />
            <origin xyz="${x} ${y} ${wheel_pos_z}" rpy="1.570796 0 0" />
        </joint>
        <gazebo reference="${name}_wheel">
            <material>Gazebo/Black</material>
            <mu1>0.2</mu1>
            <mu2>0.2</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:wheel name="front_left" x="${wheel_pos_x}" y="${wheel_pos_y}" />
    <xacro:wheel name="front_right" x="${wheel_pos_x}" y="${-wheel_pos_y}" />
    <xacro:wheel name="rear_left" x="${-wheel_pos_x}" y="${wheel_pos_y}" />
    <xacro:wheel name="rear_right" x="${-wheel_pos_x}" y="${-wheel_pos_y}" />

    <gazebo>
        <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
            <ros>
                <remapping>cmd_vel:=/cmd_vel</remapping>
                <remapping>odom:=/odom</remapping>
            </ros>
            <update_rate>100</update_rate>
            <publish_rate>50</publish_rate>
            <publish_odom>true</publish_odom>
            <!-- No EKF here: this plugin owns odom -> base_link. -->
            <publish_odom_tf>true</publish_odom_tf>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_link</robot_base_frame>
            <covariance_x>0.0001</covariance_x>
            <covariance_y>0.0001</covariance_y>
            <covariance_yaw>0.001</covariance_yaw>
        </plugin>
    </gazebo>

    <gazebo reference="base_link">
        <material>Gazebo/Grey</material>
        <sensor name="contact_sensor" type="contact">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <contact>
                <!-- Gazebo renames collisions when it lumps fixed joints; verify with
                     `gz sdf -p /tmp/martha.urdf | grep "<collision name"`. -->
                <collision>base_link_fixed_joint_lump__contact_shell_collision_collision</collision>
            </contact>
            <plugin name="gazebo_ros_bumper" filename="libgazebo_ros_bumper.so">
                <ros>
                    <remapping>bumper_states:=/bumper_states</remapping>
                </ros>
                <frame_name>base_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

    <gazebo reference="lidar">
        <material>Gazebo/Green</material>
        <sensor name="lidar_sensor" type="ray">
            <always_on>true</always_on>
            <visualize>$(arg lidar_visualize)</visualize>
            <update_rate>10</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>$(arg lidar_samples)</samples>
                        <resolution>1</resolution>
                        <min_angle>${-pi}</min_angle>
                        <max_angle>${pi}</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=/scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>
