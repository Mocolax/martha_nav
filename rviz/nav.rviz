Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /gazebo_ros_lidar/out
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Points
      Color: 239; 104; 52
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 42; 120; 214
      Line Style: Lines
    - Class: rviz_default_plugins/PointStamped
      Name: Carrot
      Enabled: true
      Topic:
        Value: /carrot
        Reliability Policy: Reliable
      Color: 237; 161; 0
      Radius: 0.12
    - Class: rviz_default_plugins/Pose
      Name: Goal
      Enabled: true
      Topic:
        Value: /goal_pose
        # Volatile on purpose: RViz's own 2D Goal Pose tool publishes volatile, and a
        # transient-local subscription would refuse those messages.
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 27; 175; 122
      Shaft Length: 0.6
      Shaft Radius: 0.06
      Head Length: 0.2
      Head Radius: 0.12
    - Class: rviz_default_plugins/RobotModel
      Name: Martha
      Enabled: true
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
  Global Options:
    Background Color: 252; 252; 251
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 70
      Target Frame: map
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
